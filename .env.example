# ==============================================================================
# FILE MẪU CẤU HÌNH MÔI TRƯỜNG (KHÔNG CHỨA MẬT KHẨU THẬT)
# Sao chép file này thành .env và điền mật khẩu MySQL thực tế của bạn
# ==============================================================================

# Khóa bí mật Flask (Session & Flash message)
SECRET_KEY=your_secret_key_here

# Thông tin tài khoản kết nối MySQL CSDL
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurantdb
